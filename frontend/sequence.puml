@startuml
actor UI

participant AudioControl
participant "AudioImpl (Platform)" as AudioImpl
participant AudioRecorder

UI -> AudioControl : startRecording()
AudioControl -> AudioImpl : getRecordConfig()
AudioControl -> AudioImpl : getStoragePath()
AudioControl -> AudioRecorder : start(config, path)

loop every 50ms
  AudioRecorder --> AudioControl : onAmplitudeChanged()
  AudioControl -> AudioControl : _analyzeAudioLevel()
end

alt silence >= 2s OR user taps stop
  UI -> AudioControl : stopRecording()
  AudioControl -> AudioRecorder : stop()
  AudioRecorder --> AudioControl : path/blobUrl
  AudioControl -> AudioImpl : readRecordBytes(path/blobUrl)
  AudioImpl --> AudioControl : base64 audio

  alt mobile implementation
    AudioImpl -> AudioImpl : delete temp recording file
  end

  AudioControl --> UI : Future<String> completed\n(audioJson: command=transcribe)
  UI -> UI : send audioJson via WebSocket
end

@enduml
